{
  "name": "green-max",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --format=agent",
    "lint:fix": "oxlint --fix --type-aware --format=agent",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-store": "^0.11.1",
    "better-result": "^3.0.1",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-textarea-autosize": "^8.5.9",
    "valibot": "^1.5.0",
    "wouter": "^3.11.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
